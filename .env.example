# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# # Optional: switch LLM_PROVIDER to openai to use this provider instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini


# Discord Configuration
# chỉnh sửa tên biến nếu cần thiết, tốt nhất là ko nên sửa 
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_optional

# LLM / OpenAI API (nếu bot có dùng để phân loại)
# OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# App Settings
ENVIRONMENT=development
DEBUG=True


# LƯU Ý: 
# nếu sửa phần dưới, phải sửa ở các file trong folder codebase để model hoạt động bình thường

# sửa nhà cung cấp, có thể là openai, anthropic, deepseek,....
LLM_PROVIDER=openrouter

# Chọn  bất kì model nào thích
OPENROUTER_MODEL=
# OPENAI_MODEL=
